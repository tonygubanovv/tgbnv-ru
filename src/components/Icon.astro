---
// Every glyph is drawn on the same 24-unit grid, so one declared pixel size means one optical size next to any other icon.
// The two brand marks come from someone else's grid (a 28 box for the plane, ink running past 24 for VK), so each carries a
// transform that fits its ink into this grid with the same 3-unit margin the line icons keep (owner, 24.10.2026: «иконки скачут»).
interface Props { name?: 'sun' | 'moon' | 'arrow' | 'folder' | 'article' | 'tag' | 'copy' | 'check' | 'link' | 'vk' | 'star' | 'menu' | 'close' | 'mail' | 'telegram-plane'; direction?: 'right' | 'left' | 'down'; size?: 14 | 16 | 18 | 20 | 24 | 28; class?: string }
const { name = 'arrow', direction = 'right', size = 20, class: className } = Astro.props;
const sizes = { 14: '--icon-small', 16: '--icon-compact', 18: '--text-4', 20: '--icon-default', 24: '--icon-large', 28: '--icon-social' } as const;
---
<svg class:list={['icon', className, { [`icon-${direction}`]: name === 'arrow' }]} style={`--icon-size:var(${sizes[size]})`} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap={name === 'sun' || name === 'moon' ? 'butt' : 'round'} stroke-linejoin={name === 'sun' || name === 'moon' ? 'miter' : 'round'} aria-hidden="true" focusable="false">
  {name === 'sun' && <><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></>}
  {name === 'moon' && <path d="M21 13a9 9 0 0 1-10-10A9 9 0 1 0 21 13Z"/>}
  {name === 'check' && <path d="m5 12 4 4L19 6" />}
  {name === 'menu' && <path d="M4 6h16M4 12h16M4 18h16" />}
  {name === 'close' && <path d="m6 6 12 12M6 18 18 6" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
  {name === 'telegram-plane' && <path transform="translate(3 4.528) scale(1.2651)" d="M13.178 0.045C13.378 -0.015 13.588 -0.015 13.798 0.045C14.038 0.115 14.168 0.275 14.198 0.505C14.208 0.655 14.208 0.765 14.228 0.915C14.178 1.314 14.138 1.754 14.078 2.184C13.978 2.944 13.868 3.693 13.748 4.453C13.568 5.612 13.368 6.772 13.178 7.932C13.028 8.821 12.869 9.711 12.698 10.591C12.659 10.82 12.579 11.051 12.469 11.271C12.239 11.75 11.899 11.9 11.389 11.77C11.069 11.69 10.799 11.531 10.539 11.35C9.32 10.531 8.11 9.711 6.901 8.881C6.711 8.751 6.521 8.602 6.361 8.431C6.121 8.182 6.111 7.922 6.301 7.632C6.371 7.532 6.441 7.432 6.531 7.352C7.28 6.632 8.04 5.923 8.79 5.203C9.41 4.613 10.009 4.004 10.619 3.404C10.689 3.334 10.769 3.254 10.739 3.134C10.709 3.014 10.639 2.944 10.519 2.964C10.439 2.974 10.359 3.004 10.289 3.044C9.469 3.574 8.64 4.113 7.82 4.653C6.791 5.343 5.761 6.032 4.732 6.722C4.092 7.152 3.402 7.242 2.672 7.022C1.983 6.812 1.293 6.612 0.613 6.393C0.464 6.342 0.313 6.263 0.184 6.172C-0.047 6.012 -0.057 5.773 0.133 5.563C0.333 5.353 0.593 5.243 0.853 5.123C2.472 4.423 4.092 3.703 5.711 3.024C7.77 2.154 9.83 1.304 11.899 0.465C12.309 0.295 12.748 0.175 13.178 0.045Z" fill="currentColor" fill-rule="evenodd" stroke="none" />}
  {name === 'star' && <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z" />}
  {name === 'vk' && <path transform="translate(2.9325 3.3681) scale(0.7502)" d="M13.162 18.994c-8.2 0-12.877-5.622-13.072-14.977h4.107c.135 6.867 3.163 9.775 5.56 10.375V4.017h3.867V9.94c2.367-.255 4.857-2.953 5.696-5.923h3.867c-.645 3.66-3.343 6.358-5.261 7.467 1.918.9 4.991 3.253 6.158 7.51h-4.257c-.914-2.848-3.193-5.052-6.203-5.352v5.352h-.462Z" fill="currentColor" stroke="none" />}
  {name === 'link' && <><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></>}
  {name === 'copy' && <><rect x="8" y="8" width="12" height="13" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" /></>}
  {name === 'arrow' && <path d="M5 12h14m-6-6 6 6-6 6" />}
  {name === 'folder' && <path d="M3 7V5h7l2 2h9v12H3V7Zm0 3h18" />}
  {name === 'article' && <><path d="M5 3h10l4 4v14H5V3Zm10 0v5h4M9 12h6m-6 4h6" /></>}
  {name === 'tag' && <><path d="m3 12 9-9h9v9l-9 9-9-9Z" /><circle cx="17" cy="7" r="1" /></>}
</svg>
