---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { dateLabel, publicationPath } from '../utils/content';
import { url } from '../utils/urls';
interface Props { entry: CollectionEntry<'blog'>; heading?: 'h2' | 'h3'; topics?: readonly string[] }
const { entry, heading: Heading = 'h2', topics } = Astro.props;
const { data } = entry;
// Three columns on a wide screen, two in the middle, one on a phone: the browser picks the variant by these widths.
// Mirrors global.css's capped container, gutters and gaps. The invariant test guards these boundaries.
const cardSizes = '(min-width: 1296px) 384px, (min-width: 1001px) calc((100vw - 144px) / 3), (min-width: 701px) calc((100vw - 88px) / 2), calc(100vw - 48px)';
---
<article class="content-card" data-topics={topics?.join(' ')}>
  <Image src={data.cover.src} alt={data.cover.alt} widths={[400, 720, 1080]} sizes={cardSizes} quality={72} loading="lazy" decoding="async" />
  <div class="card-body">
    <time class="meta" datetime={data.date}>{dateLabel(data.date)}</time>
    <Heading><a href={url(publicationPath(entry))}>{data.title}</a></Heading>
    <p>{data.summary}</p>
  </div>
</article>
