---
import { site, links, mainMenu } from '../config/site';
import { url } from '../utils/urls';
import EmailContact from './EmailContact.astro';
import Icon from './Icon.astro';
import MenuLinks from './MenuLinks.astro';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={url()} aria-label={`${site.name} — главная`}>
      <span>{site.name}<span class="brand-dot">.</span></span>
    </a>
    <details class="mobile-nav">
      <summary aria-label="Меню сайта"><span class="menu-open-icon"><Icon name="menu" size={24} /></span><span class="menu-close-icon"><Icon name="close" size={24} /></span></summary>
      <nav class="mobile-menu-panel" aria-label="Основная навигация">
        <MenuLinks items={mainMenu} />
        <div class="mobile-menu-contacts">
          <p class="group-label">Связаться</p>
          {links.email && <div class="menu-contact-row"><Icon name="mail" size={20} /><EmailContact tooltipId="menu-email-tooltip" /></div>}
          {links.telegram && <div class="menu-contact-row"><Icon name="telegram-plane" size={20} /><a href={links.telegram} target="_blank" rel="noopener noreferrer">Telegram</a></div>}
        </div>
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
  menu?.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('pointerdown', event => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
  menu?.addEventListener('focusout', event => {
    if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
  });
  // The same details changes from a full-width sheet to a card at this boundary.
  window.matchMedia('(min-width: 1001px)').addEventListener('change', () => { if (menu) menu.open = false; });
  const header = document.querySelector<HTMLElement>('.site-header');
  let lastY = window.scrollY;
  const hideDistance = 120;
  const revealDistance = 64;
  const topVisibleZone = 120;
  let scrollAnchor = lastY;
  let scheduled = false;
  const updateHeader = () => {
    // Ignore elastic overscroll at either end of the page.
    const maxY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
    const y = Math.min(maxY, Math.max(0, window.scrollY));
    const delta = y - lastY;
    if (delta !== 0) {
      const focused = document.activeElement;
      const keyboardFocus = focused instanceof HTMLElement && focused.matches(':focus-visible');
      // Focusing a link can scroll the page automatically. Keep keyboard navigation inside the panel open.
      if (menu?.open && !(keyboardFocus && menu.contains(focused))) menu.open = false;
      if (!keyboardFocus && focused instanceof HTMLElement && header?.contains(focused)) focused.blur();
    }
    if (y <= topVisibleZone || header?.contains(document.activeElement)) {
      header?.classList.remove('is-hidden');
      scrollAnchor = y;
    } else if (header?.classList.contains('is-hidden')) {
      scrollAnchor = Math.max(scrollAnchor, y);
      if (scrollAnchor - y >= revealDistance) {
        header.classList.remove('is-hidden');
        scrollAnchor = y;
      }
    } else {
      // Measure from the furthest point, so small direction changes do not toggle the header.
      scrollAnchor = Math.min(scrollAnchor, y);
      if (y - scrollAnchor >= hideDistance) {
        header?.classList.add('is-hidden');
        scrollAnchor = y;
      }
    }
    lastY = y;
    scheduled = false;
  };
  window.addEventListener('scroll', () => {
    if (!scheduled) { scheduled = true; requestAnimationFrame(updateHeader); }
  }, { passive: true });
  const revealHeader = () => {
    header?.classList.remove('is-hidden');
    scrollAnchor = Math.max(0, window.scrollY);
  };
  header?.addEventListener('focusin', revealHeader);
  menu?.addEventListener('toggle', () => { if (menu.open) revealHeader(); });
</script>

<style>
  .mobile-nav { position: static; }
  .mobile-nav summary { display: grid; place-items: center; width: var(--tap); height: var(--tap); list-style: none; background: transparent; border: 0; color: var(--foreground); transition: color var(--duration-state); }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav[open] summary, .mobile-nav summary:active { color: var(--accent); }
  @media (hover: hover) and (pointer: fine) {
    .mobile-nav summary:hover { color: var(--accent); }
  }
  .menu-open-icon, .menu-close-icon { display: flex; }
  .menu-open-icon :global(.icon), .menu-close-icon :global(.icon) { stroke-width: 2; }
  .menu-close-icon, .mobile-nav[open] .menu-open-icon { display: none; }
  .mobile-nav[open] .menu-close-icon { display: flex; }
  .mobile-nav::details-content { transition: content-visibility var(--duration-panel) allow-discrete; }
  .mobile-menu-panel { --menu-gap: 0px; position: absolute; top: calc(100% + var(--menu-gap)); inset-inline: 0; max-height: calc(100dvh - var(--header-h) - var(--menu-gap)); overflow-y: auto; overscroll-behavior: contain; padding: var(--space-3) var(--gutter) var(--space-5); background: var(--background); border-bottom: var(--line-thin) solid var(--border); box-shadow: var(--shadow-panel); }
  @supports selector(details::details-content) {
    .mobile-menu-panel { opacity: 0; transform: translateY(calc(-1 * var(--space-2))); transition: opacity var(--duration-panel) var(--ease-panel), transform var(--duration-panel) var(--ease-panel); }
    .mobile-nav[open] .mobile-menu-panel { opacity: 1; transform: translateY(0); }
    @starting-style { .mobile-nav[open] .mobile-menu-panel { opacity: 0; transform: translateY(calc(-1 * var(--space-2))); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav::details-content, .mobile-menu-panel { transition: none; }
  }
  :global(body:has(.cookie-notice:not([hidden]))) .mobile-menu-panel { max-height: calc(100dvh - var(--header-h) - var(--menu-gap) - var(--cookie-notice-height, var(--space-7))); }
  .mobile-menu-contacts { display: grid; gap: var(--space-2); border-top: var(--line-thin) solid var(--border); padding-top: var(--space-4); margin-top: var(--space-3); }
  .menu-contact-row { display: grid; grid-template-columns: var(--space-5) minmax(0, 1fr); align-items: center; gap: var(--space-2); padding-inline: var(--space-3); border-inline: var(--line-thin) solid transparent; }
  .menu-contact-row > :global(.icon) { justify-self: center; color: var(--muted); }
  .menu-contact-row :global(a) { display: flex; align-items: center; min-height: var(--tap); font-size: var(--text-2); font-weight: var(--weight-medium); overflow-wrap: anywhere; color: var(--foreground); }
  .menu-contact-row :global(a):focus-visible, .menu-contact-row :global(a):active { color: var(--accent); }
  @media (hover: hover) and (pointer: fine) {
    .menu-contact-row :global(a):hover { color: var(--accent); }
  }
  @media (min-width: 1001px) {
    /* Desktop gets a compact card under the burger instead of the full-width sheet: its own border,
       radius and a gap keep it visibly separate from the header. The glyph grows with the header
       instead of gaining a box. */
    .mobile-menu-panel { --menu-gap: var(--space-2); inset-inline: auto; right: max(var(--gutter), calc((100% - var(--page-max)) / 2)); width: var(--nav-measure); padding: var(--space-4); border: var(--line-thin) solid var(--border); border-radius: var(--radius-lg); }
    .menu-open-icon :global(.icon), .menu-close-icon :global(.icon) { width: var(--nav-icon-size); height: var(--nav-icon-size); }
  }
</style>
