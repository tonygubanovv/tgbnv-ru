---
import '../../src/styles/global.css';
import { site } from '../../src/config/site';
---
<!doctype html><html lang="ru" data-theme="dark"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><title>Обложка сайта</title></head><body>
<svg width="1200" height="630" viewBox="0 0 1200 630" aria-hidden="true"><rect width="1200" height="630" fill="var(--background)"/><g fill="none" stroke="var(--brand)"><circle cx="1000" cy="320" r="240" opacity=".14"/><circle cx="1000" cy="320" r="170" opacity=".2"/><ellipse cx="1000" cy="320" rx="270" ry="100" transform="rotate(-35 1000 320)" opacity=".6"/><circle cx="1140" cy="155" r="7" fill="var(--brand)"/></g><path d="M70 72h38M89 53v38" stroke="var(--brand)" stroke-width="2"/></svg>
<p class="label">Digital-маркетинг</p><h1>Маркетинг.</h1><p class="accent">С мыслью о главном.</p><p class="footer">{site.role}. Статьи и кейсы.</p>
</body></html>
<style>html,body{width:1200px;height:630px;margin:0;overflow:hidden;background:var(--background);color:var(--foreground);font-family:var(--font-sans)}svg{position:absolute;inset:0}p,h1{position:absolute;margin:0;left:70px;line-height:var(--leading-title);font-weight:var(--weight-regular)}.label{top:143px;font-size:22px;color:var(--brand)}h1{left:65px;top:205px;font-size:80px;font-weight:var(--weight-heading);letter-spacing:var(--tracking-heading)}.accent{left:65px;top:315px;font-size:68px;font-weight:var(--weight-heading);letter-spacing:var(--tracking-heading);color:var(--brand)}.footer{top:510px;font-size:22px;color:var(--muted)}</style>
